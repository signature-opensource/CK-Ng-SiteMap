{
    "AllowedHosts": "*",
    "CK-AppIdentity": {
        "FullName": "SiteMap/$Server",
        "Parties": [],
        "Local": {}
    },
    "CK-Monitoring": {
        "LogPath": "Logs",
        "HandleDotNetLogs": true,
        "DefaultFilter": "Debug",
        "GrandOutput": {
            "Handlers": {
                "Console": true,
                "TextFile": {
                    "Path": "Text"
                }
            }
        }
    },
    "Logging": {
        "LogLevel": {
            "Default": "Information",
            "Microsoft": "Warning",
            "Microsoft.Hosting.Lifetime": "Warning"
        },
        "Console": {
            "LogLevel": {
                "Default": "None"
            },
            "FormatterOptions": {
                "IncludeScopes": false
            }
        },
        "Debug": {
            "LogLevel": {
                "Default": "None"
            }
        }
    }
}
